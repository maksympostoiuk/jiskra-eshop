# Database — SQLite for local dev. For production use PostgreSQL, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/eshop?schema=public"
# (and change `provider` in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"

# Public base URL of the storefront (used for canonical URLs, sitemap, emails, Stripe redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First admin user created by the seed script
SEED_ADMIN_EMAIL="admin@jiskra.local"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_NAME="Admin"

# Optional: Stripe (test mode). The Stripe payment method is only offered when this is set.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Mailer: "console" (default, prints e-mails) | "smtp" (needs SMTP_URL) | "file" (JSON lines in MAIL_OUTBOX)
MAILER="console"
MAIL_FROM="Jiskra <obchod@jiskra.local>"
# SMTP_URL="smtps://user:password@smtp.example.com:465"
# MAIL_OUTBOX="tmp/mail-outbox.jsonl"

# File storage: "local" (default, public/uploads) | "s3" (AWS S3 / Cloudflare R2 / MinIO; objects stay private
# and are served through /uploads)
STORAGE="local"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PREFIX="uploads/"
